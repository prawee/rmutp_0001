# Test API
@username={{$dotenv USER_USERNAME}}
@password={{$dotenv USER_PASSWORD}}
@email={{$dotenv USER_EMAIL}}

### Identification / Register account
POST http://localhost:8090/api/auth/local/register HTTP/1.1
Content-Type: application/json

{
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "{{password}}"
}


### Get all users
GET http://localhost:8090/api/users HTTP/1.1
Content-Type: application/json

### Authentication / Login
POST http://localhost:8090/api/auth/local HTTP/1.1
Content-Type: application/json

{
    "identifier": "{{username}}",
    "password": "{{password}}"
}

### Get profile
GET http://localhost:8090/api/users/me HTTP/1.1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiaWF0IjoxNzUzNjA3NTA0LCJleHAiOjE3NTYxOTk1MDR9.xpFov8PHkifvnin89_ajiVBhF0rS1Wa3SqSff-hVeQY

### Update profile
PUT http://localhost:8090/api/users/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiaWF0IjoxNzUzNjA3NTA0LCJleHAiOjE3NTYxOTk1MDR9.xpFov8PHkifvnin89_ajiVBhF0rS1Wa3SqSff-hVeQY

{
    "username": "{{username}} update"
}